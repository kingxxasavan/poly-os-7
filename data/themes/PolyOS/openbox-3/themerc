# PolyOS window decorations for Openbox 3.
# Circular title-bar buttons (the .xbm masks here) on a seamless dark title bar,
# following PolyOS 7. Colors are the PolyOS 7 palette (ui/css/polyos.css).

border.width: 1
padding.width: 12
padding.height: 8
window.handle.width: 3
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap: 0
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3
window.label.text.justify: left
menu.title.text.justify: center

# ---- active window ----
window.active.border.color: #2a2a2c
window.active.client.color: #151515
window.active.title.bg: flat solid
window.active.title.bg.color: #151515
window.active.title.separator.color: #151515
window.active.label.bg: parentrelative
window.active.label.text.color: #ffffff
window.active.handle.bg: flat solid
window.active.handle.bg.color: #151515
window.active.grip.bg: flat solid
window.active.grip.bg.color: #151515

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #8a8a8e
window.active.button.hover.bg: parentrelative
window.active.button.hover.image.color: #678fd9
window.active.button.pressed.bg: parentrelative
window.active.button.pressed.image.color: #4f76c0
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #8a8a8e
window.active.button.toggled.hover.bg: parentrelative
window.active.button.toggled.hover.image.color: #678fd9
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #3a3a3c

# ---- inactive window ----
window.inactive.border.color: #202022
window.inactive.client.color: #121212
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #121212
window.inactive.title.separator.color: #121212
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #979797
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #121212
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #121212

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #48484b
window.inactive.button.hover.bg: parentrelative
window.inactive.button.hover.image.color: #8a8a8e
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.pressed.image.color: #4f76c0
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #48484b
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #2c2c2e

# ---- menus (window menu, Alt+Tab) ----
menu.border.color: #2a2a2c
menu.title.bg: flat solid
menu.title.bg.color: #1c1c1e
menu.title.text.color: #ffffff
menu.items.bg: flat solid
menu.items.bg.color: #151515
menu.items.text.color: #e8eaed
menu.items.disabled.text.color: #5b5b5b
menu.items.active.bg: flat solid
menu.items.active.bg.color: #678fd9
menu.items.active.text.color: #ffffff
menu.separator.color: #2a2a2c

# ---- on-screen displays ----
osd.border.color: #2a2a2c
osd.bg: flat solid
osd.bg.color: #151515
osd.label.bg: flat solid
osd.label.bg.color: #151515
osd.label.text.color: #ffffff
osd.hilight.bg: flat solid
osd.hilight.bg.color: #678fd9
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2a2a2c

# Per-button colors (Openbox 3.6+; ignored by older versions): red close like PolyOS
window.active.button.close.hover.image.color: #c76969
window.active.button.close.pressed.image.color: #a85656
window.inactive.button.close.hover.image.color: #c76969
