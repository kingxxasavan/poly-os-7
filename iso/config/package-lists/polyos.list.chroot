# Installed into the live image. polyos-desktop and polyos-shell come from
# config/packages.chroot (copied there by `main.py iso`).
polyos-desktop

# Live system. The PolyOS installer (setup on the live USB) uses the tools below;
# Calamares stays as the "Advanced installer" for manual partitioning.
live-boot
live-config
live-config-systemd
calamares
calamares-settings-debian
sudo
user-setup
locales
keyboard-configuration

# PolyOS installer: partitioning, filesystems, copying the system, boot loaders
util-linux
dosfstools
e2fsprogs
ntfs-3g
squashfs-tools
os-prober
efibootmgr
mokutil
grub2-common
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-signed
shim-signed

# Driver Manager and PolyMarket
pciutils
usbutils
isenkram-cli
nvidia-detect
flatpak

# Everyday apps and hardware (webcam for the Camera app, power modes, idle timers)
evince
power-profiles-daemon
libxss1
gstreamer1.0-plugins-good
gstreamer1.0-libav
bluez
blueman

# Boot splash
plymouth
plymouth-label

# Hardware support
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-libertas
firmware-sof-signed
intel-microcode
amd64-microcode
